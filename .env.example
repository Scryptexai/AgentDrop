# ============================================================================
# HERMES AIRDROP AGENT — ENVIRONMENT VARIABLES (template)
# ============================================================================
# Copy to `.env`, fill in real values, never commit it.
#   cp .env.example .env
#
# Every variable name below was checked against the real Hermes Agent source
# (NousResearch/hermes-agent, cli-config.yaml.example + .env.example). Nothing
# here is invented — see docs/research.md for the exact provenance of each key.
#
# The CDP_* / NOVNC_* / VNC_* / CHROME_CFT_PATH variables in sections 2-3 are
# AgentDrop's own: they are read by lib/40-browser.sh, not by Hermes.
#
# IMPORTANT — Hermes routing rule (docs/user-guide/configuration):
#   Secrets (API keys, tokens, passwords) MUST live in .env.
#   Everything else goes in config.yaml.
#   `hermes config set OPENROUTER_API_KEY sk-or-...` writes to .env for you.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. MODEL PROVIDER — pick ONE block, delete or leave the others empty.
#    `model.default` in config.yaml uses the "provider/model" form, e.g.
#    anthropic/claude-sonnet-4  —  run `hermes model` to list valid slugs.
# ----------------------------------------------------------------------------

# --- Option A: Anthropic direct (requires model.provider: anthropic) --------
ANTHROPIC_API_KEY=

# --- Option B: OpenRouter aggregator (model.provider: openrouter) -----------
# Hermes' own default base_url is https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# --- Option C: OpenAI (model.provider: auto/openai) ------------------------
OPENAI_API_KEY=

# --- Option D: Google AI Studio (model.provider: gemini) --------------------
GOOGLE_API_KEY=

# --- Option E: Nous Portal (model.provider: nous-api) ----------------------
NOUS_API_KEY=

# ============================================================================
# MODEL YANG DIPAKAI SEMUA WORKER  (WAJIB diisi ketiganya)
# ============================================================================
# config.yaml tidak lagi meng-hardcode model. Ia merujuk ketiga variabel ini:
#
#   model.default  = ${AGENTDROP_MODEL}
#   model.provider = ${AGENTDROP_PROVIDER}
#   model.base_url = ${AGENTDROP_BASE_URL}
#
# Kenapa: install.sh menyalin config.yaml dari repo ke ~/.hermes dan ke setiap
# profil. Selama modelnya di-hardcode di repo, setiap `./install.sh` MENGHAPUS
# provider yang sudah Anda setel lewat dashboard Hermes. Dengan merujuk .env,
# install ulang tidak bisa menghapusnya — installer tidak pernah menyentuh .env.
#
# Hermes meng-expand ${VAR} di config.yaml (hermes_cli/config.py:2723) dan .env
# di-load override=True SEBELUM config dibaca (hermes_cli/env_loader.py:117),
# jadi urutannya aman.
#
# PENTING: variabel yang TIDAK di-set dibiarkan verbatim oleh Hermes
# (config.py:2767) — model.default jadi string "${AGENTDROP_MODEL}" apa adanya
# dan setiap worker gagal. `agentdrop status` memeriksa ketiganya terisi.
#
# Contoh OpenRouter (default):
AGENTDROP_MODEL=anthropic/claude-sonnet-4
AGENTDROP_PROVIDER=openrouter
AGENTDROP_BASE_URL=https://openrouter.ai/api/v1

# WAJIB. Kalau kosong, Hermes memakai ceiling native model — claude-sonnet-4
# bernilai 64.000 (agent/anthropic_adapter.py:175) — dan OpenRouter menolak
# dengan HTTP 402 "You requested up to 64000 tokens, but can only afford 2666"
# pada akun ber-kredit terbatas. Agent jadi gagal di panggilan PERTAMA, bukan
# lambat. Nilai config menang atas default model (agent_init.py:2384).
# 8192 cukup untuk satu aksi browser + penalaran.
AGENTDROP_MAX_TOKENS=8192

# Hanya dipakai kalau AGENTDROP_PROVIDER=custom. Dibiarkan kosong saat provider
# lain, dan install.sh membuang blok custom_providers dari config.
AGENTDROP_PROVIDER_NAME=agentdrop-custom
AGENTDROP_API_MODE=auto

# Contoh endpoint OpenAI-compatible lain (vLLM / Ollama / LM Studio / proxy):
#   AGENTDROP_MODEL=nama-model-di-server-anda
#   AGENTDROP_PROVIDER=custom
#   AGENTDROP_BASE_URL=http://localhost:11434/v1

# --- Option F: any OpenAI-compatible endpoint (model.provider: custom) -----
# Endpoint OpenAI-compatible (vLLM / Ollama / LM Studio / llama.cpp / proxy).
#
# PENTING — hanya CUSTOM_API_KEY yang dibaca Hermes. CUSTOM_BASE_URL TIDAK.
# hermes_cli/models.py:4080 mengambil api_key dari CUSTOM_API_KEY, tapi
# _get_custom_base_url() (models.py:2836-2839) membaca base_url dari
# `model.base_url` di config.yaml:
#
#     def _get_custom_base_url() -> str:
#         model_cfg = _get_model_config_dict()
#         return str(model_cfg.get("base_url", "")).strip()
#
# Sejak model dipindah ke .env, model.base_url = ${AGENTDROP_BASE_URL_*}.
# Jadi endpoint Anda diisi ke AGENTDROP_BASE_URL, BUKAN ke CUSTOM_BASE_URL.
# Baris CUSTOM_BASE_URL di bawah dipertahankan hanya agar tidak membingungkan
# yang sudah telanjur mengisinya — ia tidak berpengaruh apa pun.
#
# Pakai provider `custom` dan isi tiga variabel ini:
#
#   AGENTDROP_PROVIDER=custom
#   AGENTDROP_BASE_URL=https://endpoint-anda/v1
#   AGENTDROP_MODEL=<id model persis seperti yang dilaporkan endpoint>
#   AGENTDROP_API_MODE=codex_responses
#   CUSTOM_API_KEY=<kunci endpoint>
#
# AGENTDROP_API_MODE menentukan jalur API yang dipakai endpoint. Pilihan yang
# diterima Hermes (lihat menu `hermes model`):
#   auto             -> heuristik URL, untuk endpoint OpenAI-compatible standar
#   chat_completions -> /chat/completions
#   codex_responses  -> /responses, untuk backend tool-calling ala Codex
#   anthropic_messages -> /v1/messages
# SALAH MEMILIH INI membuat tool calling gagal walau modelnya benar. Endpoint
# yang menawarkan DeepSeek/GLM/Kimi biasanya butuh codex_responses.
#
# `/v1` di akhir tidak wajib: probe_api_models (models.py:5706-5720) mencoba
# bentuk dengan dan tanpa `/v1`. Tapi menuliskannya menghindarkan satu
# percobaan jaringan yang gagal.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=http://localhost:11434/v1


# ----------------------------------------------------------------------------
# 2. BROWSER — Chrome for Testing lewat CDP
# ----------------------------------------------------------------------------
# AgentDrop menyalakan Chrome for Testing sendiri (`agentdrop browser`) lalu
# Hermes ATTACH ke sana. Browser bawaan Hermes adalah headless Chromium tanpa
# ekstensi, jadi tidak bisa dipakai untuk task yang butuh wallet.
#
# Port ini harus sama dengan browser.cdp_url di config.yaml.
CDP_PORT=9222
# Direktori profil Chrome. Login (Google/Discord/X) bertahan di sini.
CDP_PROFILE_DIR=~/.agentdrop/chrome-profile
# Direktori induk ekstensi. Setiap subdirektori berisi manifest.json dimuat.
CDP_EXT_ROOT=~/.agentdrop/extensions
# Jalur Chrome for Testing kalau terpasang di tempat tidak biasa.
CHROME_CFT_PATH=

# ----------------------------------------------------------------------------
# 3. GUI BROWSER (noVNC) — supaya browser bisa DILIHAT dan DIAMBIL ALIH
# ----------------------------------------------------------------------------
# Login Google/Discord/X, OAuth, dan CAPTCHA dikerjakan MANUSIA, bukan agent.
# noVNC memberi GUI sungguhan di http://localhost:6080/vnc.html untuk itu.
#
# Dependency: xvfb, x11vnc, novnc (Debian/Ubuntu: apt install xvfb x11vnc novnc)
NOVNC_PORT=6080

# Layar browser. Chrome for Testing adalah aplikasi desktop biasa dengan ikon
# sendiri, jadi di mesin berlayar ia muncul sebagai jendela normal -- itu yang
# paling andal untuk login manual dan popup ekstensi wallet.
#
#   auto    (default) pakai layar mesin kalau ada, kalau tidak pakai noVNC
#   native  paksa jendela asli; berhenti kalau mesin tidak punya layar
#   vnc     paksa lewat Xvfb + noVNC, walaupun mesin punya layar
#
# Set 'vnc' hanya untuk mesin tanpa layar (VPS, container). noVNC punya
# kelemahan nyata: popup ekstensi sering tidak bisa dibuka di dalamnya.
BROWSER_MODE=auto
VNC_PORT=5900
CDP_DISPLAY=99
CDP_RESOLUTION=1920x1080x24
# WAJIB diisi kalau port 6080 bisa diakses dari luar mesin ini.
VNC_PASSWORD=


# ----------------------------------------------------------------------------
# 4. TELEGRAM — UI utama. Anda mengirim task ke bot ini.
# ----------------------------------------------------------------------------
# Nama variabel di bawah persis dari hermes-agent/.env.example bagian
# "TELEGRAM INTEGRATION".
#
# Buat bot lewat @BotFather -> /newbot -> salin token ke bawah.
TELEGRAM_BOT_TOKEN=

# WAJIB diisi. Tanpa ini bot menerima perintah dari SIAPA PUN yang menemukannya.
# Ambil user ID Anda dari @userinfobot. Pisahkan dengan koma untuk beberapa.
TELEGRAM_ALLOWED_USERS=

# Chat default untuk pengiriman hasil cron (laporan harian/mingguan).
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=
# Kalau home channel Anda forum/group bertopik, isi topic ID-nya.
TELEGRAM_CRON_THREAD_ID=

# Webhook (opsional — hanya untuk deployment cloud seperti Fly.io/Railway).
# Default-nya long polling, yang lebih sederhana dan tidak butuh domain.
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_PORT=8443
# TELEGRAM_WEBHOOK_SECRET=

# Notifikasi fallback yang dipakai scripts/ sendiri (bukan gateway Hermes).
TELEGRAM_CHAT_ID=


# ----------------------------------------------------------------------------
# 5. WALLET MONITORING — optional, READ-ONLY ADDRESSES ONLY
# ----------------------------------------------------------------------------
# ============================================================================
#  HARD RULE: public addresses only. Never put a private key, seed phrase,
#  keystore, or JSON wallet anywhere in this file. Hermes auto-redacts its
#  logs, but a secret committed to git is gone forever. See README "Keamanan".
# ============================================================================
WALLET_ADDRESS_MAIN=
WALLET_ADDRESS_FARMING=


# ----------------------------------------------------------------------------
# 6. PROJECT PATHS
# ----------------------------------------------------------------------------
# Absolute path of this repository. Used by cron --workdir and by the skills
# to locate data/campaigns/.
AGENTDROP_HOME=


# ----------------------------------------------------------------------------
# 7. WALLET — untuk tooling, BUKAN untuk signing otomatis
# ----------------------------------------------------------------------------
# Wallet yang dipakai agent adalah MetaMask / OKX / Phantom yang dipasang di
# browser (agentdrop extensions). Kuncinya dipegang manusia di dalam wallet itu,
# dan approval ditandatangani manusia lewat noVNC.
#
# Berkas key di bawah HANYA untuk tooling CLI: cek saldo, pantau portofolio,
# verifikasi klaim. Agent tidak signing dengan key ini.
#
# PRIVATE KEY TIDAK BOLEH ADA DI FILE INI. .env tersalin ke setiap profil
# Hermes, jadi satu key di sini berarti key itu ada di tujuh tempat. Taruh di
# berkas terpisah:
#
#     mkdir -p ~/.agentdrop
#     printf '0xPRIVKEY_ANDA' > ~/.agentdrop/wallet.key
#     chmod 600 ~/.agentdrop/wallet.key
#
# install.sh menanyakan ini dan menulis berkasnya untuk Anda.
AGENTDROP_KEY_FILE=~/.agentdrop/wallet.key

# Chain default untuk tooling. 1 = Ethereum mainnet, 11155111 = Sepolia.
AGENTDROP_CHAIN_ID=1

# RPC untuk baca saldo/nonce. Kosong = pakai RPC publik bawaan.
AGENTDROP_RPC_URL=
