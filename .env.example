# ============================================================================
# HERMES AIRDROP AGENT — ENVIRONMENT VARIABLES (template)
# ============================================================================
# Copy to `.env`, fill in real values, never commit it.
#   cp .env.example .env
#
# Every variable name below was checked against the real Hermes Agent source
# (NousResearch/hermes-agent, cli-config.yaml.example + .env.example) and the
# real camofox-browser source (jo-inc/camofox-browser README). Nothing here is
# invented — see docs/research.md for the exact provenance of each key.
#
# IMPORTANT — Hermes routing rule (docs/user-guide/configuration):
#   Secrets (API keys, tokens, passwords) MUST live in .env.
#   Everything else goes in config.yaml.
#   `hermes config set OPENROUTER_API_KEY sk-or-...` writes to .env for you.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. MODEL PROVIDER — pick ONE block, delete or leave the others empty.
#    `model.default` in config.yaml uses the "provider/model" form, e.g.
#    anthropic/claude-sonnet-4  —  run `hermes model` to list valid slugs.
# ----------------------------------------------------------------------------

# --- Option A: Anthropic direct (requires model.provider: anthropic) --------
ANTHROPIC_API_KEY=

# --- Option B: OpenRouter aggregator (model.provider: openrouter) -----------
# Hermes' own default base_url is https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# --- Option C: OpenAI (model.provider: auto/openai) ------------------------
OPENAI_API_KEY=

# --- Option D: Google AI Studio (model.provider: gemini) --------------------
GOOGLE_API_KEY=

# --- Option E: Nous Portal (model.provider: nous-api) ----------------------
NOUS_API_KEY=

# --- Option F: any OpenAI-compatible endpoint (model.provider: custom) -----
# Use this for vLLM / Ollama / LM Studio / llama.cpp.
# Set model.base_url in config.yaml to the same origin.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=http://localhost:11434/v1


# ----------------------------------------------------------------------------
# 2. CAMOFOX BROWSER — client side (read by HERMES)
#    These four are exactly the names in hermes-agent/.env.example.
# ----------------------------------------------------------------------------
# Route Hermes' browser tools through a local Camofox server.
# Leave unset to use Hermes' default browser (agent-browser / Browserbase).
CAMOFOX_URL=http://localhost:9377

# Send a stable profile-scoped userId so the server maps it to a persistent
# Firefox profile. This is what makes logins survive between sessions.
# Mirrors browser.camofox.managed_persistence: true in config.yaml.
CAMOFOX_USER_ID=

# Pair with CAMOFOX_USER_ID when another app owns the visible browser and
# Hermes should operate inside that same identity.
CAMOFOX_SESSION_KEY=

# true = reuse an already-open Camofox tab for this identity before creating
# a new one (useful across gateway restarts).
CAMOFOX_ADOPT_EXISTING_TAB=false


# ----------------------------------------------------------------------------
# 3. CAMOFOX SERVER — server side (read by the container, not by Hermes)
#    Consumed by docker-compose.yml. Do not confuse with the block above.
# ----------------------------------------------------------------------------
CAMOFOX_PORT=9377
# 0.0.0.0 = reachable from other containers/hosts; 127.0.0.1 = loopback only.
CAMOFOX_BIND_HOST=0.0.0.0
# If set, every route except /health, cookie-import and /stop requires
# `Authorization: Bearer <key>`. Strongly recommended if BIND_HOST is 0.0.0.0.
CAMOFOX_ACCESS_KEY=
# Required for POST /stop.
CAMOFOX_ADMIN_KEY=
# Persistent, on-disk locations. Bind-mounted by docker-compose.yml.
CAMOFOX_PROFILE_DIR=/data/profiles
CAMOFOX_COOKIES_DIR=/data/cookies
CAMOFOX_TRACES_DIR=/data/traces
# Image built locally by `make build` in the camofox-browser checkout —
# there is no published registry image. See scripts/start-browser.sh.
CAMOFOX_VERSION=135.0.1
CAMOFOX_ARCH=x86_64

# ----------------------------------------------------------------------------
# 3b. GUI BROWSER (VNC) — supaya browser bisa DILIHAT dan DIAMBIL ALIH
# ----------------------------------------------------------------------------
# Camofox headless secara default. Plugin vnc-nya menjalankan Camoufox di
# Xvfb 1920x1080 lalu mengeksposnya lewat noVNC, jadi Anda dapat GUI sungguhan
# di http://localhost:6080/vnc.html — tempat Anda login manual, selesaikan MFA
# atau CAPTCHA, lalu agent lanjut memakai sesi yang sama.
#
# Dependency-nya (x11vnc, novnc, python3-websockify) sudah ada di image.
ENABLE_VNC=1
NOVNC_PORT=6080
# WAJIB diisi kalau port 6080 bisa diakses dari luar mesin ini.
VNC_PASSWORD=

# Mode window lokal. 'off' untuk Docker (GUI-nya lewat noVNC).
# 'desktop' hanya berguna di mesin dengan desktop grafis nyata.
CAMOFOX_INTERACTIVE=off


# ----------------------------------------------------------------------------
# 4. TELEGRAM — UI utama. Anda mengirim task ke bot ini.
# ----------------------------------------------------------------------------
# Nama variabel di bawah persis dari hermes-agent/.env.example bagian
# "TELEGRAM INTEGRATION".
#
# Buat bot lewat @BotFather -> /newbot -> salin token ke bawah.
TELEGRAM_BOT_TOKEN=

# WAJIB diisi. Tanpa ini bot menerima perintah dari SIAPA PUN yang menemukannya.
# Ambil user ID Anda dari @userinfobot. Pisahkan dengan koma untuk beberapa.
TELEGRAM_ALLOWED_USERS=

# Chat default untuk pengiriman hasil cron (laporan harian/mingguan).
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=
# Kalau home channel Anda forum/group bertopik, isi topic ID-nya.
TELEGRAM_CRON_THREAD_ID=

# Webhook (opsional — hanya untuk deployment cloud seperti Fly.io/Railway).
# Default-nya long polling, yang lebih sederhana dan tidak butuh domain.
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_PORT=8443
# TELEGRAM_WEBHOOK_SECRET=

# Notifikasi fallback yang dipakai scripts/ sendiri (bukan gateway Hermes).
TELEGRAM_CHAT_ID=


# ----------------------------------------------------------------------------
# 5. WALLET MONITORING — optional, READ-ONLY ADDRESSES ONLY
# ----------------------------------------------------------------------------
# ============================================================================
#  HARD RULE: public addresses only. Never put a private key, seed phrase,
#  keystore, or JSON wallet anywhere in this file. Hermes auto-redacts its
#  logs, but a secret committed to git is gone forever. See README "Keamanan".
# ============================================================================
WALLET_ADDRESS_MAIN=
WALLET_ADDRESS_FARMING=


# ----------------------------------------------------------------------------
# 6. PROJECT PATHS
# ----------------------------------------------------------------------------
# Absolute path of this repository. Used by cron --workdir and by the skills
# to locate data/campaigns/.
AGENTDROP_HOME=


# ----------------------------------------------------------------------------
# 7. SIGNING DAEMON — rute wallet otonom
# ----------------------------------------------------------------------------
# Daemon ini (tools/signing_daemon.py) yang menandatangani transaksi setelah
# tools/signing_policy.py mengizinkan. Bind 127.0.0.1 saja.
#
# PRIVATE KEY TIDAK BOLEH ADA DI FILE INI. Taruh di file terpisah:
#
#     mkdir -p ~/.hermes
#     printf '0xPRIVKEY_ANDA' > ~/.hermes/agentdrop-signer.key
#     chmod 600 ~/.hermes/agentdrop-signer.key
#
# Daemon menolak jalan kalau izin file itu lebih longgar dari 600 (peringatan)
# dan menolak jalan sama sekali kalau token di bawah ini kosong.

# Path ke file private key. Ini cara yang disarankan.
AGENTDROP_KEY_FILE=~/.hermes/agentdrop-signer.key

# Token bersama antara daemon dan extension browser. Tanpa ini daemon menolak
# semua request (403). Buat yang panjang dan acak:
#     openssl rand -hex 32
AGENTDROP_SIGNER_TOKEN=

# Chain yang dipakai daemon. 1 = Ethereum mainnet, 11155111 = Sepolia.
AGENTDROP_CHAIN_ID=1

# Port daemon. Hanya didengarkan di 127.0.0.1.
AGENTDROP_SIGNER_PORT=9721

# RPC untuk broadcast & ambil nonce. Kosong = daemon mengembalikan raw tx
# yang sudah ditandatangani tapi tidak menyiarkannya.
AGENTDROP_RPC_URL=
